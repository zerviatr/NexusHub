# NexusHub API Server

# ─── App ───────────────────────────────────────────────────────
PORT=3000

# ─── Database (Turso) ──────────────────────────────────────────
# Local dev: file URL (no auth needed)
# Production: get from https://turso.tech
TURSO_URL=file:./nexushub.db
TURSO_AUTH_TOKEN=

# ─── Security ──────────────────────────────────────────────────
# Same secret used in Electron licenseStore.ts
NEXUS_LICENSE_SECRET=NEXUS_DEV_SECRET_DO_NOT_USE_IN_PROD

# HMAC secret for device ID hashing
DEVICE_HMAC_SECRET=change_me_in_production_device_secret

# Master Password for Railway Web Admin Console
ADMIN_SECRET=nexus_admin_change_this_in_railway

# ─── LemonSqueezy ──────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=your_ls_api_key_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_ls_webhook_secret_here
LEMONSQUEEZY_STORE_ID=your_store_id_here

# ─── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=NexusHub <license@yourdomain.com>

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to allow all in dev)
ALLOWED_ORIGINS=
